---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import CreateCardForm from "@/components/cards/CreateCardForm";
---

<Layout title="New card">
  <div class="bg-cosmic min-h-screen p-4">
    <Topbar />

    <div class="flex items-center justify-center py-12">
      <div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1
          class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
        >
          New card
        </h1>
        <p class="mb-6 text-center text-sm text-blue-100/60">
          New cards are due straight away, so they turn up in your next review.
        </p>

        <CreateCardForm client:load />
      </div>
    </div>
  </div>
</Layout>
